rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /capacity_tracker/{docId} {
      allow read, write: if true;
    }
    match /capacity_snapshots/{docId} {
      allow read, write: if true;
    }
    match /admin_settings/{docId} {
      allow read, write: if true;
    }
  }
}

